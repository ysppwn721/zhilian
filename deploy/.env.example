# Copy to deploy/.env on the cloud server. Do not commit the real file.
ZHILIAN_DOMAIN=zhilian.space
ACME_EMAIL=replace-with-your-email@example.com
ZHILIAN_ACCESS_PASSWORD=replace-with-a-long-demo-password
DEEPSEEK_API_KEY=
# rules | local | hybrid | api | api_only（默认 hybrid）
ZHILIAN_LLM_MODE=hybrid
# 语义论断候选召回：只返回句子编号，默认关闭。
ZHILIAN_SEMANTIC_RECALL=0
# 可选价格（元/百万 token），不配置则不估算费用。
ZHILIAN_INPUT_PRICE_PER_MILLION=
ZHILIAN_OUTPUT_PRICE_PER_MILLION=
ZHILIAN_LOCAL_RERANKER_ENABLED=0
# 每日模型调用限额（超限自动降级为规则模式，审计记录"模型额度用尽"）。
# 单访客默认 60 次、全局默认 600 次；按自然日清零。
ZHILIAN_QUOTA_PER_CLIENT=60
ZHILIAN_QUOTA_GLOBAL=600
