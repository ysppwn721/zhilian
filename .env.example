# Copy to .env. Keep keys on the server; never commit .env.
ZHILIAN_HOST=127.0.0.1
ZHILIAN_PORT=8765
# Required before binding 0.0.0.0. Username is zhilian.
ZHILIAN_ACCESS_PASSWORD=zhilian2026
# 大赛提交要求：软件若设用户名密码，必须在设计文档显著位置注明测试账号。

# DeepSeek official API. Configure the key on the server only.
# Customers use the website without providing their own API keys.
# Empty key keeps rules + manual review available.
DEEPSEEK_API_KEY=
# DeepSeek V4.1 Flash API model ID, verified against official docs on 2026-09-19.
DEEPSEEK_MODEL=deepseek-flash

# 关联路由模式：rules | local | hybrid | api | api_only
# 默认 hybrid：规则唯一项直接处理，困难项先走本地 BGE，再由 API 兜底。
# rules/local 可离线使用；api/api_only 会产生远程调用费用。
ZHILIAN_LLM_MODE=hybrid
# 语义论断候选召回：只返回句子编号，默认关闭；开启后仍需人工确认，不会自动改文件。
ZHILIAN_SEMANTIC_RECALL=0
# 可选价格（元/百万 token），不配置则只记录 token，不虚构费用。
ZHILIAN_INPUT_PRICE_PER_MILLION=
ZHILIAN_OUTPUT_PRICE_PER_MILLION=

# 模型调用限额：演示环境用服务端密钥替使用者付费，而测试账号按大赛要求公开，
# 因此必须限流。超限不报错，自动降级为规则模式，并在审计里记一条"模型额度用尽"。
# 计数按自然日清零，落在数据目录的 quota.json；访客标识优先取 CF-Connecting-IP。
ZHILIAN_QUOTA_PER_CLIENT=60
ZHILIAN_QUOTA_GLOBAL=600

# 修复完成后本地落盘输出。默认目录为项目根目录下的“导出成果”。
ZHILIAN_OUTPUT_DIR=
# 设为 1 或 true 时，智能体完成后自动落盘；默认关闭。
ZHILIAN_AUTO_EXPORT=0

# Optional local ONNX reranker. Leave empty to use the rules/API fallback.
ZHILIAN_LOCAL_RERANKER_PATH=
ZHILIAN_LOCAL_RERANKER_ENABLED=0
# 可选：覆盖目录内默认文件，并在健康检查/模型账本中显示名称。
# 年报专用候选示例：
# ZHILIAN_LOCAL_RERANKER_PATH=models/zh_reranker_bert_annual_repaired_v1_onnx_compat
# ZHILIAN_LOCAL_RERANKER_FILE=model_fp32.onnx
# ZHILIAN_LOCAL_RERANKER_NAME=annual-repaired-bert-fp32
ZHILIAN_LOCAL_RERANKER_FILE=
ZHILIAN_LOCAL_RERANKER_NAME=
# 年报自动识别后的可选模型；留空则识别到年报时回退默认本地模型。
ZHILIAN_ANNUAL_RERANKER_PATH=
ZHILIAN_ANNUAL_RERANKER_FILE=model_fp32.onnx
ZHILIAN_ANNUAL_RERANKER_NAME=annual-repaired-bert-fp32
ZHILIAN_ANNUAL_RERANKER_ENABLED=0
ZHILIAN_LOCAL_RERANKER_DEVICE=auto
ZHILIAN_RERANKER_MAX_LENGTH=512
ZHILIAN_RERANKER_MIN_RAW_SCORE=-2.5
ZHILIAN_RERANKER_MIN_MARGIN=0.10
ZHILIAN_ANNUAL_RERANKER_MIN_RAW_SCORE=-3.0
ZHILIAN_ANNUAL_RERANKER_MIN_MARGIN=0.10
